17:32:52.888057 [debug]: Query executed on node model.saas_project.int_customer_subscriptions:
create or replace   view SAAS_DB.ANALYTICS.int_customer_subscriptions
  
  
  
  
  as (
    with customers as (select * from SAAS_DB.ANALYTICS_STAGING.stg_telco_customers),
plans     as (select * from SAAS_DB.ANALYTICS_STAGING.stg_telco_plans),
finance   as (select * from SAAS_DB.ANALYTICS_STAGING.stg_telco_finance)

select
    c.customer_id,
    c.gender,
    c.is_senior,
    c.tenure_months,
    p.contract_type,
    p.internet_service,
    f.monthly_charges,
    f.total_charges,
    f.churn_status
from customers c
left join plans p    on c.customer_id = p.customer_id
left join finance f  on c.customer_id = f.customer_id
  )
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.saas_project.int_customer_subscriptions", "profile_name": "saas_project", "target_name": "dev"} */
