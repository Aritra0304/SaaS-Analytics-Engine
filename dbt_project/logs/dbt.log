04:43:53.246651 [debug]: Query executed on node model.saas_project.stg_telco_customers:
create or replace   view SAAS_DB.ANALYTICS_STAGING.stg_telco_customers
  
  
  
  
  as (
    with source as (
    select * from SAAS_DB.RAW.telco_data_raw
)
select
    customerID                              as customer_id,
    gender,
    -- SeniorCitizen is stored as INT (0/1); cast to BOOLEAN for type safety
    IFF(SeniorCitizen = 1, TRUE, FALSE)     as is_senior,
    -- Partner / Dependents are stored as VARCHAR 'Yes'/'No'; cast to BOOLEAN
    IFF(Partner = 'Yes', TRUE, FALSE)       as has_partner,
    IFF(Dependents = 'Yes', TRUE, FALSE)    as has_dependents,
    tenure                                  as tenure_months
from source
  )
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.saas_project.stg_telco_customers", "profile_name": "saas_project", "target_name": "dev"} */
04:43:53.332779 [debug]: Query executed on node model.saas_project.stg_telco_finance:
create or replace   view SAAS_DB.ANALYTICS_STAGING.stg_telco_finance
  
  
  
  
  as (
    with source as (
    select * from SAAS_DB.RAW.telco_data_raw
)
select
    customerID                              as customer_id,
    MonthlyCharges                          as monthly_charges,
    -- TotalCharges is VARCHAR in the raw source (contains blank strings for new customers);
    -- TRY_CAST handles those gracefully by returning NULL instead of raising an error
    TRY_CAST(TotalCharges as FLOAT)         as total_charges,
    Churn                                   as churn_status
from source
  )
